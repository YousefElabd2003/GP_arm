<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="config_arm_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import config_arm_robot urdf file -->
    <xacro:include filename="$(find my_robotic_arm)/urdf/config_arm_robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="config_arm_robot.ros2_control.xacro" />


    <xacro:config_arm_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
